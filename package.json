{
  "name": "tamu-fiji",
  "version": "0.1.0",
  "private": true,
  "description": "Public website for the Phi Gamma Delta (FIJI) chapter at Texas A&M University.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:calendar": "node scripts/check-calendar.mjs",
    "check:sheet": "node scripts/check-sheet.mjs"
  },
  "//": "Version ranges use ^ deliberately: `npm install` then picks up security patches on its own. A chapter site that nobody touches for a semester should not drift onto an unpatched release. Run `npm audit` at the start of each semester.",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^16.2.11",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.2.11",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  }
}
