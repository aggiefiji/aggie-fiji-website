# Copy to .env.local and fill in ONLY when the chapter is ready to go live.
# Nothing in this file is required for local development — every integration
# falls back to a safe stub when the variable is missing.
# See src/integrations.config.ts for the full list.

# --- Google Sheet holding giving figures and the chapter wishlist ---
# IMPORTANT: no NEXT_PUBLIC_ prefix. These are read on the server only, so the
# API key never reaches a visitor's browser. Do not rename them.
# Never put donor names in the sheet — it is link-viewable. Date + Amount only.
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_ID=

# --- Google Calendar holding the events list ---
# The calendar ID from Google Calendar → Settings → the calendar → Integrate
# calendar. The calendar must be set to "Make available to public".
# See CALENDAR-SETUP.md.
GOOGLE_CALENDAR_ID=
# Optional. Leave blank to reuse GOOGLE_SHEETS_API_KEY.
# GOTCHA: a key restricted to "Sheets API only" is REJECTED for Calendar. Either
# add the Calendar API to that key's restrictions, or set a second key here.
GOOGLE_CALENDAR_API_KEY=
# Optional. Defaults to America/Chicago.
GOOGLE_CALENDAR_TIMEZONE=

# --- CMS login (GitHub OAuth) ---
# Set these in the HOSTING environment (Vercel → Project → Settings →
# Environment Variables), not here — this file never deploys.
# Create the OAuth app at GitHub → Settings → Developer settings → OAuth Apps.
# Authorization callback URL must be https://YOUR-DOMAIN/api/callback
# The secret is a real credential: never commit it.
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=
# Optional. Defaults to "repo". Narrow to "public_repo" if the site repo is
# public — the token officers carry then cannot touch their private repos.
GITHUB_OAUTH_SCOPE=

# --- Analytics ---
# Chosen: "vercel". Also enable Web Analytics in the Vercel dashboard.
# No ID needed for vercel. "plausible" and "ga4" both require the ID below.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=

# --- Giving / donations ---
# DECIDED: no payment processor. Gifts come by Venmo, Zelle, and cheque.
# Setting this does nothing on its own — giving.enabled is hard-coded false.
NEXT_PUBLIC_GIVING_URL=

# --- Site URL, used for share links and metadata ---
# ⚠️  MUST be set to the real origin in the hosting environment. Left at
# localhost, the sitemap, robots.txt and every link preview point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
